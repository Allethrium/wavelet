# -*- text -*-
##
##  eap.conf -- Configuration for EAP types (PEAP, TTLS, etc.)

eap eap_wifi {
    default_eap_type = tls
    timer_expire = 60
    ignore_unknown_eap_types = no
    cisco_accounting_username_bug = no
    max_sessions = ${max_requests}
    tls-config tls_eap_wifi {
    #	This is the RADIUS service principal TLS key.  NOT the RADSEC TLS key!
    #	private_key_password = whatever
        private_key_file = ${certdir}/radius.key
        certificate_file = ${certdir}/radius.pem
        ca_file = ${cadir}/ca.crt
        ca_path = ${cadir}
        auto_chain = yes
        auto_chain = yes
        cipher_list = "HIGH"
        check_all_crl = no
        cipher_server_preference = no
        ssl_version = TLSv1.2-TLSv1.3
        tls_min_version = "1.2"
        tls_max_version = "1.3"
        dh_curve = "prime256v1"
	}

    #  EAP-TLS
    #  The TLS configuration for TLS-based EAP types is held in the "tls-config" section, above.
    tls {
        tls = tls_eap_wifi
        configurable_client_cert = no
    }
}
