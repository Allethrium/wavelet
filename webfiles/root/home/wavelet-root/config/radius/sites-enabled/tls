######################################################################
#
#  RADIUS over TLS (radsec)
#
######################################################################

listen {
	ipaddr = *
	port = 2083
	type = auth+acct
	proto = tcp
	virtual_server = default
	clients = radsec
#	proxy_protocol = no
#	nonblock = yes
#	check_client_connections = yes

	limit {
	      max_connections = 16
	      lifetime = 0
	      idle_timeout = 30
	}

	tls {
		private_key_password = whatever
		private_key_file = ${certdir}/radsec.key
	#	allow_expired_crl = no
		certificate_file = ${certdir}/radsec.crt
		ca_file = ${cadir}/ca.crt
	#	dh_file = ${certdir}/dh
	#	random_file = /dev/urandom
		fragment_size = 8192
	#	include_length = yes
	#	check_crl = yes
		ca_path = ${cadir}
		ca_path_reload_interval = 3600
	#	check_cert_cn = %{User-Name}
		cipher_list = "ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-GCM-SHA256"
		cipher_server_preference = no
		tls_min_version = "1.2"
		tls_max_version = "1.3"
		ecdh_curve = ""
		cache {
		      enable = no
		      lifetime = 24 # hours
		      #name = "TLS ${..ipaddr} ${..port} ${..proto}"
		      #persist_dir = "${logdir}/tlscache"
		}

		verify {
		#	tmpdir = /tmp/radiusd
		#	client = "/path/to/openssl verify -CApath ${..ca_path} %{TLS-Client-Cert-Filename}"
		}
	#	realm_dir = ${certdir}/realms/
	}
}

clients radsec {
	client radseccli {
		ipaddr = 127.0.0.1
		proto = tls
		secret = radsec
		virtual_server = default
	}
	#_APPEND_RADSEC_CLIENT_HERE
}

home_server tls {
	ipaddr = 127.0.0.1
	port = 2083
	type = auth+acct
	secret = radsec
	proto = tcp
	status_check = none
#	nonblock = yes
	tls {
		#private_key_password = whatever
		private_key_file = ${certdir}/radsec.key
		certificate_file = ${certdir}/radsec.crt
		ca_file = ${cadir}/ca.crt
	}
}

home_server_pool tls {
 	type = fail-over
 	home_server = tls
}
realm tls {
     	auth_pool = tls
     	acct_pool = tls
}