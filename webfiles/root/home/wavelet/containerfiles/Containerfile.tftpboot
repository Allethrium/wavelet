# This container should download appropriate packages,
# And generate a fully functional /var/lib/tftpboot directory.
# It takes a bash script input from the launch directory.
# Called from systemd init unit during server spinup
# Order is:
# ExecStartPre = build
# Exec = RUN
# ExecPost = wavelet_pxe_grubconfig.sh

FROM quay.io/fedora/fedora:latest
RUN rm /etc/yum.repos.d/fedora-cisco-openh264.repo && mkdir -p /tmp/boot_rpms && dnf update -y --refresh 
RUN dnf install -y dnf-utils grub2-efi-x64-modules grub2-tools-extra grub2-pc-modules shadow-utils \
    podman fuse-overlayfs cpio --exclude container-selinux && \
    grub2-mknetdir --net-directory /tmp/var/lib/tftpboot/
RUN cd /tmp/boot_rpms && yumdownloader shim shim-x64 grub2-efi grub2-efi-x64
RUN cd /tmp/boot_rpms && \
    echo -e "\nLOOKING FOR FILES: " && \
    ls -laht /tmp/boot_rpms/ && \
    grub2efi32=$(ls /tmp/boot_rpms/grub2-efi-ia32*.rpm) && \
    grub2efi64=$(ls /tmp/boot_rpms/grub2-efi-x64*.rpm) && \
    shim=$(ls /tmp/boot_rpms/shim*.rpm | grep shim) && \
    rpm2cpio ${grub2efi32} | cpio -idmuv && \
    rpm2cpio ${grub2efi64} | cpio -idmuv && \
    rpm2cpio ${shim} | cpio -idmuv && \
    # Notes, mmx64.efi = MokManager
    echo -e "\nLOOKING FOR EFI FILES:" && \
    mkdir -p /tmp/var/lib/tftpboot/EFI/fedora && \
    mkdir -p /tmp/var/lib/tftpboot/EFI/BOOT && \
    mkdir -p /tmp/var/lib/tftpboot/boot/grub2/fonts && \
    cp /tmp/boot_rpms/boot/grub2/fonts/unicode.pf2 /tmp/var/lib/tftpboot/boot/grub2/fonts/ && \
    cp /tmp/boot_rpms/boot/grub2/grubenv /tmp/var/lib/tftpboot/boot/grub2/ && \
    GRUBX64=$(find /tmp/boot_rpms/usr/lib/efi/grub2 -name 'grubx64.efi' | head -n1) && \
    GRUBIA32=$(find /tmp/boot_rpms/usr/lib/efi/grub2 -name 'grubia32.efi' | head -n1) && \
    cp "$GRUBX64" /tmp/var/lib/tftpboot/EFI/fedora/ && \
    cp "$GRUBIA32" /tmp/var/lib/tftpboot/EFI/fedora/ && \
    SHIMX64=$(find /tmp/boot_rpms/usr/lib/efi/shim -name 'shimx64.efi' | head -n1) && \
    SHIM=$(find /tmp/boot_rpms/usr/lib/efi/shim -name 'shim.efi' | head -n1) && \
    MMX64=$(find /tmp/boot_rpms/usr/lib/efi/shim -name 'mmx64.efi' | head -n1) && \
    cp "$SHIMX64" /tmp/var/lib/tftpboot/EFI/fedora/ && \
    cp "$SHIM" /tmp/var/lib/tftpboot/EFI/fedora/ && \
    cp "$MMX64" /tmp/var/lib/tftpboot/EFI/fedora/ && \
    BOOTX64=$(find /tmp/boot_rpms/usr/lib/efi/shim -name 'BOOTX64.EFI' | head -n1) && \
    FBX64=$(find /tmp/boot_rpms/usr/lib/efi/shim -name 'fbx64.efi' | head -n1) && \
    cp "$BOOTX64" /tmp/var/lib/tftpboot/EFI/BOOT/ && \
    cp "$FBX64" /tmp/var/lib/tftpboot/EFI/BOOT/
RUN mkdir -p /tar_root && \
    tar -cf tftpboot.tar.xz /tmp/var/lib/tftpboot && \
    cp tftpboot.tar.xz /tar_root
CMD cd /tmp && mkdir -p tftpboot && \
    cp /tar_root/tftpboot.tar.xz /tmp && ls -lah && \
    tar -xvf tftpboot.tar.xz --strip-components=3

# TO USE:
# chdir to containerfile dir
# sudo podman build --tag shim -f ./<PATH>/Containerfile.tftpboot
# Yes, we're mounting directly to root.  Yes, this is dangerous.
# podman run --privileged --security-opt label=disable -v /var/lib:/tmp/ shim